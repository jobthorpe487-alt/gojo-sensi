* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

:root {
    --bg: #050509;
    --panel: #0d0d15;
    --panel2: #12121c;
    --text: #f4f4ff;
    --muted: #8c8c9d;
    --purple: #8b5cf6;
    --purple2: #6d28d9;
    --border: rgba(139, 92, 246, 0.25);
    --danger: #ff4d67;
}

body {
    min-height: 100vh;
    background:
        radial-gradient(
            circle at top,
            rgba(109, 40, 217, 0.20),
            transparent 35%
        ),
        var(--bg);

    color: var(--text);
    font-family:
        Arial,
        Helvetica,
        sans-serif;

    overflow-x: hidden;
}

button,
select,
input {
    font: inherit;
}


/* TOP BAR */

.topbar {
    width: 100%;
    min-height: 76px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 14px 6%;

    border-bottom: 1px solid var(--border);

    background: rgba(5, 5, 9, 0.92);

    position: sticky;
    top: 0;
    z-index: 100;

    backdrop-filter: blur(12px);
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
}

.brand-icon {
    width: 44px;
    height: 44px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 12px;

    background:
        linear-gradient(
            135deg,
            var(--purple),
            var(--purple2)
        );

    font-size: 23px;
    font-weight: 900;

    box-shadow:
        0 0 25px rgba(139, 92, 246, 0.35);
}

.brand h1 {
    font-size: 18px;
    letter-spacing: 2px;
}

.brand h1 span {
    color: var(--purple);
}

.brand p {
    color: var(--muted);
    font-size: 8px;
    letter-spacing: 2px;
    margin-top: 3px;
}


/* INSTALL */

.install-btn {
    border: 1px solid var(--purple);
    background: transparent;
    color: white;

    padding: 9px 14px;

    border-radius: 8px;

    font-size: 11px;
    font-weight: bold;

    cursor: pointer;
}

.hidden {
    display: none !important;
}


/* HERO */

.hero {
    width: 100%;
    min-height: 340px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 50px 20px;

    position: relative;

    background:
        linear-gradient(
            180deg,
            transparent,
            rgba(139, 92, 246, 0.05)
        );
}

.hero::before {
    content: "";

    position: absolute;

    width: 250px;
    height: 250px;

    border-radius: 50%;

    background: var(--purple);

    filter: blur(130px);

    opacity: 0.15;
}

.hero-content {
    max-width: 700px;

    text-align: center;

    position: relative;
    z-index: 1;
}

.status {
    display: inline-flex;

    align-items: center;
    gap: 8px;

    border: 1px solid var(--border);

    padding: 7px 13px;

    border-radius: 50px;

    color: #b9a4ff;

    font-size: 10px;
    font-weight: bold;

    margin-bottom: 22px;
}

.status span {
    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: #54e38e;

    box-shadow:
        0 0 10px #54e38e;
}

.hero h2 {
    font-size: clamp(38px, 9vw, 70px);

    line-height: 0.95;

    letter-spacing: -2px;

    margin-bottom: 20px;
}

.hero h2 strong {
    display: block;

    color: var(--purple);

    text-shadow:
        0 0 35px rgba(139, 92, 246, 0.35);
}

.hero p {
    max-width: 520px;

    margin: auto;

    color: var(--muted);

    line-height: 1.7;

    font-size: 14px;
}


/* MAIN */

main {
    width: min(760px, 92%);

    margin: auto;

    padding-bottom: 50px;
}


/* PANELS */

.panel {
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,0.035),
            rgba(255,255,255,0.015)
        );

    border: 1px solid var(--border);

    border-radius: 18px;

    padding: 22px;

    margin-bottom: 18px;

    box-shadow:
        0 20px 60px rgba(0,0,0,0.25);
}

.panel-title {
    display: flex;
    align-items: center;
    gap: 10px;

    margin-bottom: 22px;
}

.panel-title span {
    color: var(--purple);

    font-size: 11px;
    font-weight: 900;
}

.panel-title h3 {
    font-size: 15px;
    letter-spacing: 1.5px;
}


/* FORMS */

label {
    display: block;

    color: var(--muted);

    font-size: 10px;
    font-weight: bold;

    letter-spacing: 1.5px;

    margin-bottom: 8px;
}

select {
    width: 100%;

    color: white;

    background: var(--panel2);

    border: 1px solid rgba(255,255,255,0.08);

    border-radius: 10px;

    padding: 14px;

    outline: none;

    margin-bottom: 18px;

    cursor: pointer;
}

select:focus {
    border-color: var(--purple);
}


/* SLIDERS */

.slider-item {
    margin-bottom: 20px;
}

.slider-item:last-child {
    margin-bottom: 0;
}

.slider-header {
    display: flex;

    align-items: center;
    justify-content: space-between;
}

.slider-header label {
    margin-bottom: 8px;
}

output {
    color: var(--purple);

    font-weight: 900;

    font-size: 15px;
}

input[type="range"] {
    width: 100%;

    height: 5px;

    appearance: none;

    border-radius: 10px;

    background: #242432;

    outline: none;
}

input[type="range"]::-webkit-slider-thumb {
    appearance: none;

    width: 18px;
    height: 18px;

    border-radius: 50%;

    background: var(--purple);

    border: 3px solid #17121f;

    box-shadow:
        0 0 15px rgba(139, 92, 246, 0.5);

    cursor: pointer;
}

input[type="range"]::-moz-range-thumb {
    width: 18px;
    height: 18px;

    border-radius: 50%;

    background: var(--purple);

    border: 3px solid #17121f;

    cursor: pointer;
}


/* BUTTONS */

.actions {
    display: grid;

    grid-template-columns: 1fr 120px;

    gap: 10px;

    margin-bottom: 18px;
}

button {
    border: 0;
    cursor: pointer;

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
}

button:active {
    transform: scale(0.97);
}

.primary-btn {
    min-height: 55px;

    border-radius: 12px;

    color: white;

    font-weight: 900;

    letter-spacing: 1px;

    background:
        linear-gradient(
            135deg,
            var(--purple),
            var(--purple2)
        );

    box-shadow:
        0 10px 35px rgba(109, 40, 217, 0.25);
}

.primary-btn:hover {
    box-shadow:
        0 12px 40px rgba(139, 92, 246, 0.4);
}

.secondary-btn {
    min-height: 55px;

    border-radius: 12px;

    color: var(--muted);

    background: var(--panel2);

    border: 1px solid rgba(255,255,255,0.08);
}


/* RESULTS */

.result-grid {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 10px;
}

.result-card {
    padding: 18px 10px;

    border-radius: 12px;

    text-align: center;

    background: rgba(139, 92, 246, 0.05);

    border: 1px solid rgba(139, 92, 246, 0.12);
}

.result-card span {
    display: block;

    color: var(--muted);

    font-size: 8px;

    letter-spacing: 1px;

    margin-bottom: 8px;
}

.result-card strong {
    font-size: 28px;

    color: white;
}

.copy-btn {
    width: 100%;

    margin-top: 14px;

    padding: 14px;

    border-radius: 10px;

    background: var(--panel2);

    border: 1px solid var(--border);

    color: white;

    font-weight: bold;
}

.copy-btn:hover {
    border-color: var(--purple);
}

.copy-status {
    text-align: center;

    color: #54e38e;

    font-size: 11px;

    margin-top: 10px;

    min-height: 14px;
}


/* INFO */

.info {
    padding: 15px 4px;
}

.info h3 {
    color: var(--purple);

    margin-bottom: 10px;

    letter-spacing: 2px;
}

.info > p {
    color: var(--muted);

    font-size: 13px;

    line-height: 1.7;
}

.warning {
    margin-top: 18px;

    padding: 15px;

    border-left: 3px solid var(--purple);

    background: rgba(139, 92, 246, 0.05);

    border-radius: 0 10px 10px 0;
}

.warning strong {
    font-size: 10px;

    color: var(--purple);

    letter-spacing: 1px;
}

.warning p {
    color: var(--muted);

    font-size: 11px;

    line-height: 1.6;

    margin-top: 5px;
}


/* FOOTER */

footer {
    text-align: center;

    padding: 30px 20px 45px;

    border-top: 1px solid var(--border);

    color: var(--muted);

    font-size: 10px;

    line-height: 1.8;
}


/* MOBILE */

@media (max-width: 520px) {

    .topbar {
        padding: 12px 4%;
    }

    .brand h1 {
        font-size: 15px;
    }

    .brand-icon {
        width: 39px;
        height: 39px;
    }

    .hero {
        min-height: 300px;
    }

    .hero h2 {
        font-size: 43px;
    }

    .panel {
        padding: 18px;
    }

    .result-grid {
        grid-template-columns:
            repeat(2, 1fr);
    }

    .actions {
        grid-template-columns: 1fr;
    }

    .secondary-btn {
        min-height: 45px;
    }
}
